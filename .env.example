# =============================================================================
# LCA Wiki bot (lca-bot): environment variables
# =============================================================================
# Copy to .env.local for `npm run dev`, or to .env.docker for docker compose.
# [REQUIRED] variables crash the app at startup when missing.

# --- App ---
NODE_ENV=development                                # development | production | test
NEXT_PUBLIC_APP_URL=http://localhost:3000            # [REQUIRED in prod] public origin, no trailing slash
CONTACT_EMAIL=info@d-d-s.ch                         # [OPTIONAL] shown on the login page

# --- Auth ---
JWT_SECRET=                                         # [REQUIRED] openssl rand -base64 48

# --- Database ---
DATABASE_URL=postgres://postgres:postgres@localhost:54322/postgres  # [REQUIRED]
DB_POOL_SIZE=10                                     # [OPTIONAL]

# --- Anthropic ---
ANTHROPIC_API_KEY=                                  # [REQUIRED unless MOCK_ANTHROPIC=1]
MOCK_ANTHROPIC=                                     # [OPTIONAL] 1 = scripted mock client answers every chat call, no ANTHROPIC_API_KEY or network call needed
CHAT_MODEL=claude-opus-5                            # [OPTIONAL] model for answers
TITLE_MODEL=claude-haiku-4-5-20251001               # [OPTIONAL] model for conversation titles

# --- Wiki ---
WIKI_REPO_URL=https://github.com/sentier-dev/lca-wiki.git
WIKI_PUBLIC_BASE_URL=https://github.com/sentier-dev/lca-wiki/blob
WIKI_DATA_DIR=/data/wiki                            # compose volume; /tmp/wiki on Cloud Run
WIKI_SYNC_INTERVAL_MINUTES=60
WIKI_SYNC_DISABLED=0                                # 1 = never git pull (point WIKI_DATA_DIR at a local checkout)
WIKI_SYNC_SECRET=                                   # [OPTIONAL] shared secret for POST /api/wiki/sync
# npm run dev outside Docker: WIKI_DATA_DIR=/home/laurenz/dds/lca-wiki WIKI_SYNC_DISABLED=1

# --- Google sign-in (optional; button hidden when unset). Existing accounts only. ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Password reset email (optional; unset = reset links are logged to stdout) ---
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=LCA Wiki

# --- Logging ---
LOG_LEVEL=info
